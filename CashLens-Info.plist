<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Donations are consumables that DonationManager finishes at
	     purchase. By default StoreKit excludes finished consumables
	     from `Transaction.all`, which would make the donor
	     grandfathering scan (ProManager.scanForDonorGrant) find
	     nothing. This key (iOS 18+) opts finished consumables back
	     into the transaction history. All other Info.plist content
	     is still generated by GENERATE_INFOPLIST_FILE — Xcode merges
	     this file with the generated keys. -->
	<key>SKIncludeConsumableInAppPurchaseHistory</key>
	<true/>
	<!-- Export compliance: CashLens uses no encryption beyond what the
	     OS provides (HTTPS / on-device data protection), which is
	     exempt. Declaring it here skips the App Store Connect export
	     compliance prompt on every build upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- App Lock (Wave 3): Face ID unlock for the optional local app
	     lock. Falls back to the device passcode automatically. -->
	<key>NSFaceIDUsageDescription</key>
	<string>CashLens uses Face ID to unlock the app when App Lock is turned on. Nothing leaves your device.</string>
	<!-- Wave 5: cashlens:// deep links. Used by the Quick Log widget's
	     "+" button to open the add-expense sheet (see DeepLinkRouter /
	     DeepLinkURLs). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.rushi.CashLens</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cashlens</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
